# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is git-ignored so your credentials stay out of source control.

# --- Credentials (required - the program will not start without these) ---
CUSTOMER_ID=your-customer-id-here
EMAIL=your-email-here
# Wrap the password in quotes if it contains '#' or leading/trailing spaces.
PASSWORD="your-password-here"

# --- Input file ---
# true reads CSV_FILE_NAME, false reads JSON_FILE_NAME.
IS_CSV=true
CSV_FILE_NAME=testData.csv
JSON_FILE_NAME=testData.json

# --- API endpoints ---
AUTH_URL=https://api.joinworth.com/auth/api/v1/admin/sign-in
CASE_URL=https://api.joinworth.com/case/api/v1/businesses/customers

# --- Batching and throttling ---
# Keep BATCH_SIZE at 1 to avoid overloading the API.
BATCH_SIZE=1
# Milliseconds to wait between batch requests.
DELAY_INTERVAL_MS=10000

# --- Token refresh ---
TOKEN_LIFETIME_MINUTES=60
TOKEN_REFRESH_BUFFER_MINUTES=10

# --- Logging ---
ERROR_LOG_FILE_NAME=error_log.txt
